{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "JARVIS — local system manager & AI assistant",
  "author": "Mr Arumugam Abinav",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && nodemon --watch electron --ext js --delay 400ms --exec electron .\"",
    "prebuild": "node scripts/prebuild-win.cjs",
    "build": "vite build && node scripts/build-electron-win.cjs",
    "postbuild": "node -e \"const fs=require('fs'),p=require('path'),cwd=process.cwd(),notes=p.join(cwd,'important notes'),rel=p.join(cwd,'release');if(fs.existsSync(notes)){const out=p.join(rel,'important notes');fs.mkdirSync(out,{recursive:true});for(const f of fs.readdirSync(notes))fs.copyFileSync(p.join(notes,f),p.join(out,f));const setup=p.join(notes,'SETUP-NEW-PC.txt');if(fs.existsSync(setup))fs.copyFileSync(setup,p.join(rel,'SETUP-NEW-PC.txt'));}\"",
    "icon:sync": "electron scripts/sync-app-icon.cjs",
    "build:renderer": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.5.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/templates/**/*",
      "build/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
